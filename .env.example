# RepoCrew configuration — copy to .env and fill in what you need.
# Everything works out of the box in demo mode with NO keys and NO internet.

# demo  = deterministic scripted agent trajectories, real sandboxed pytest (DEFAULT)
# live  = real Claude tool-use agents (requires ANTHROPIC_API_KEY)
RC_MODE=demo

# Required only for RC_MODE=live:
ANTHROPIC_API_KEY=
RC_MODEL=claude-sonnet-5-5

# Optional: when both are set, approving a run creates a real branch + PR
# via the GitHub REST API (repo as "owner/name"). Otherwise RepoCrew produces
# a full PR preview with copy & download buttons.
GITHUB_TOKEN=
RC_GITHUB_REPO=

# Optional: GitHub webhook HMAC SHA256 secret
GITHUB_WEBHOOK_SECRET=

# Allowed CORS origins in comma-separated list (defaults to local dev origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo execution speed (normal | fast)
RC_DEMO_SPEED=normal

# Frontend API base URL (leave empty for same-origin)
VITE_API_URL=
